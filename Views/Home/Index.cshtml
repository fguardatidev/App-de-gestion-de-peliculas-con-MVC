@{ ViewData["Title"] = "Inicio"; }

<div class="home-shell">
    <div class="home-glow" aria-hidden="true"></div>
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-brand"><span class="brand-icon" aria-hidden="true">◆</span><span>Movie App</span></div>
        <div class="home-eyebrow">TU COLECCIÓN, A TU MANERA</div>
        <h1 id="home-title">Todo tu cine.<br><span>En un solo lugar.</span></h1>
        <p class="home-intro">Explorá tu catálogo, encontrá tus títulos favoritos y organizá cada película por género de forma simple.</p>

        <nav class="home-menu" aria-label="Menú principal">
            <a class="home-card featured" asp-controller="Movies" asp-action="Index">
                <span class="card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M8 5l2.5 4M14 5l2.5 4"/></svg>
                </span>
                <span class="card-copy"><strong>Películas</strong><small>Explorá y administrá tu catálogo</small></span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>
            <a class="home-card" asp-controller="Genre" asp-action="Index">
                <span class="card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H10l2 2h5.5A2.5 2.5 0 0 1 20 9.5v7A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5v-9Z"/><path d="M8 12h8M8 15h5"/></svg>
                </span>
                <span class="card-copy"><strong>Géneros</strong><small>Organizá las categorías de tu colección</small></span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>
        </nav>
    </section>

    <aside class="home-poster" aria-hidden="true">
        <div class="poster-frame">
            <div class="poster-light"></div>
            <div class="film film-one"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="film film-two"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="poster-word">CINEMA</div><div class="poster-caption">Stories worth keeping</div>
        </div>
    </aside>
</div>
